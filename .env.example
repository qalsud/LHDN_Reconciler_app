# --- LHDN Reconciliation Engine ---
GL_PATH=samples/gl_sample.csv
LHDN_PATH=samples/lhdn_sample.json
OUTPUT_PATH=output/reconciliation_summary.xlsx
DATE_TOLERANCE_DAYS=2
AMOUNT_TOLERANCE_RM=0.05
SST_TOLERANCE_RM=0.05
LOG_LEVEL=INFO
# --- Hybrid AI layer (Phases 2-4) ---
# OPENAI_API_KEY=sk-your-key-here
# XAI_API_KEY=xai-your-key-here  (get one at https://console.x.ai)
# GEMINI_API_KEY=AIza-your-key-here  (get one at https://aistudio.google.com/apikey)
AI_MODEL=gemini/gemini-3.6-flash
AI_VISION_MODEL=gemini-3.6-flash
AI_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_EMBED_MODEL=all-MiniLM-L6-v2
ANOMALY_THRESHOLD=85
ANOMALY_CONTAMINATION=0.10
